# Reference template for the environment variables used by the project.
# The Spring Boot backend reads these from your environment (shell / IDE / CI) —
# the app does NOT load a ".env" file by itself.
#
# Set them in your shell before running:
#   PowerShell:  $env:DB_URL="jdbc:postgresql://localhost:5432/expense_tracker"
#   bash/zsh:    export DB_URL="jdbc:postgresql://localhost:5432/expense_tracker"
#
# NEVER commit real secrets.

# PostgreSQL JDBC URL
DB_URL=jdbc:postgresql://localhost:5432/expense_tracker

# PostgreSQL credentials
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT signing secret: Base64-encoded value of at least 32 bytes (HS256).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000